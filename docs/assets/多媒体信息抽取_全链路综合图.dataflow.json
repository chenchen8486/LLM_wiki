{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "多媒体信息抽取知识管道 · 全链路综合图",
    "output": "docs/4_多媒体信息抽取_全链路综合图.html",
    "viewBox": [
      1500,
      720
    ],
    "quality_profile": "standard",
    "views": [
      {
        "id": "mainline",
        "label": "主证据链主线",
        "focus": [
          "collect",
          "extract",
          "folder",
          "card",
          "grade",
          "main",
          "supp",
          "termalign",
          "distill",
          "entries",
          "graph",
          "specbook",
          "blind",
          "dev"
        ],
        "note": "采集、归档、分级、对齐、蒸馏、图谱、组装、盲评，证据正常流动的主路径。"
      },
      {
        "id": "clue-channel",
        "label": "线索层受限通道",
        "focus": [
          "grade",
          "clue",
          "cluelists",
          "triage",
          "termalign",
          "entries",
          "registries"
        ],
        "note": "线索层只产三份清单，只能指路：别名进登记表走人工确认，断言走三态闭环回查。"
      },
      {
        "id": "distill-internals",
        "label": "蒸馏层内部机制",
        "focus": [
          "termalign",
          "distill",
          "entries",
          "registries",
          "triage"
        ],
        "note": "结构冻结加金样板先行，蒸馏只读原文、逐句覆盖，顺带沉淀三份登记册。"
      },
      {
        "id": "graph-queries",
        "label": "图谱与三类查询",
        "focus": [
          "entries",
          "graph",
          "check",
          "query",
          "registries",
          "specbook",
          "cleanup"
        ],
        "note": "图谱是蒸馏产物的关系索引，校验器强制出处纪律，规格、风险、覆盖三类查询走确定性匹配。"
      },
      {
        "id": "qa-loop",
        "label": "质量保障闭环",
        "focus": [
          "distill",
          "entries",
          "registries",
          "query",
          "specbook",
          "cleanup",
          "blind",
          "dev"
        ],
        "note": "开工前定结构做金样板，干活中两条生产纪律，交付前组装、清算、盲评，通过率不低于 85%。"
      }
    ]
  },
  "stages": [
    {
      "label": "L0 采集与归档"
    },
    {
      "label": "L1 分级与分流"
    },
    {
      "label": "L1.5 对齐 · L2 蒸馏"
    },
    {
      "label": "L3 规格与索引"
    },
    {
      "label": "把关与交付"
    }
  ],
  "nodes": [
    {
      "id": "collect",
      "type": "external",
      "label": "多渠道语料收集",
      "sublabel": "pdf / ppt / doc / md / txt",
      "stage": 0,
      "row": 0,
      "tag": "不做质量预判"
    },
    {
      "id": "extract",
      "type": "backend",
      "label": "结构化抽取",
      "sublabel": "保留章节编号树",
      "stage": 0,
      "row": 1,
      "tag": "MinerU 等工具"
    },
    {
      "id": "folder",
      "type": "database",
      "label": "文档文件夹",
      "sublabel": "原文+MD+目录索引",
      "stage": 0,
      "row": 2,
      "tag": "只读事实库"
    },
    {
      "id": "card",
      "type": "database",
      "label": "元信息卡",
      "sublabel": "身份 + 分级回写",
      "stage": 0,
      "row": 3,
      "tag": "全生命周期档案"
    },
    {
      "id": "translation",
      "type": "database",
      "label": "译文附件",
      "sublabel": "仅供人阅读定位",
      "stage": 0,
      "row": 4,
      "tag": "衍生资料 不入证据链"
    },
    {
      "id": "main",
      "type": "database",
      "label": "主证据层",
      "sublabel": "官方操作级 每领域1~2份",
      "stage": 1,
      "row": 0,
      "tag": "人工指定 蒸馏主要依据"
    },
    {
      "id": "supp",
      "type": "database",
      "label": "补充证据层",
      "sublabel": "有主证据缺失的信息",
      "stage": 1,
      "row": 1,
      "tag": "须标置信度 冲突听主证据"
    },
    {
      "id": "grade",
      "type": "backend",
      "label": "L1 三维分级",
      "sublabel": "权威性×相关性×密度",
      "stage": 1,
      "row": 2,
      "tag": "卡片+目录+抽样 不读全文"
    },
    {
      "id": "clue",
      "type": "backend",
      "label": "线索层",
      "sublabel": "播客 / 综述 / 博客",
      "stage": 1,
      "row": 3,
      "tag": "永不进证据链"
    },
    {
      "id": "drop",
      "type": "external",
      "label": "丢弃",
      "sublabel": "仅用词沾边",
      "stage": 1,
      "row": 4,
      "tag": "只留元信息卡备查"
    },
    {
      "id": "termalign",
      "type": "database",
      "label": "术语对齐与登记表",
      "sublabel": "canonical_id + aliases",
      "stage": 2,
      "row": 0,
      "tag": "合并与补登永远人工确认"
    },
    {
      "id": "distill",
      "type": "backend",
      "label": "L2 蒸馏",
      "sublabel": "五类骨架 × 领域字段表",
      "stage": 2,
      "row": 1,
      "tag": "金样板先行 只读原文"
    },
    {
      "id": "entries",
      "type": "database",
      "label": "entries.jsonl",
      "sublabel": "source 到章节级",
      "stage": 2,
      "row": 2,
      "tag": "置信度+状态 全链路主产物"
    },
    {
      "id": "registries",
      "type": "database",
      "label": "三份登记册",
      "sublabel": "盲区 / 冲突 / 待仲裁",
      "stage": 2,
      "row": 3,
      "tag": "缺口与悬案随手记账"
    },
    {
      "id": "cluelists",
      "type": "database",
      "label": "线索层三清单",
      "sublabel": "概念提及/断言日志/检索词表",
      "stage": 2,
      "row": 4,
      "tag": "只指路不作数"
    },
    {
      "id": "check",
      "type": "security",
      "label": "非法结构校验器",
      "sublabel": "无出处边即非法等四条",
      "stage": 3,
      "row": 0,
      "tag": "强制拦截 违规出报告"
    },
    {
      "id": "graph",
      "type": "database",
      "label": "知识图谱",
      "sublabel": "3 类节点 · 6 种边",
      "stage": 3,
      "row": 1,
      "tag": "初期即 entries.jsonl 本身"
    },
    {
      "id": "query",
      "type": "backend",
      "label": "三类逆向查询",
      "sublabel": "规格 / 风险 / 覆盖",
      "stage": 3,
      "row": 2,
      "tag": "jq+grep 确定性取数"
    },
    {
      "id": "triage",
      "type": "backend",
      "label": "断言三态回查",
      "sublabel": "证实 / 证伪 / 查无",
      "stage": 3,
      "row": 3,
      "tag": "回查主与补充证据层"
    },
    {
      "id": "specbook",
      "type": "backend",
      "label": "规格书组装",
      "sublabel": "定稿 md / html 有目录",
      "stage": 4,
      "row": 1,
      "tag": "不产生新知识"
    },
    {
      "id": "cleanup",
      "type": "backend",
      "label": "清单清算",
      "sublabel": "盲区+冲突+低置信逐项处置",
      "stage": 4,
      "row": 2,
      "tag": "覆盖差集清零"
    },
    {
      "id": "blind",
      "type": "security",
      "label": "盲评",
      "sublabel": "懂行人 非作者",
      "stage": 4,
      "row": 3,
      "tag": "通过率 ≥85% 才放行"
    },
    {
      "id": "dev",
      "type": "external",
      "label": "进入开发",
      "sublabel": "规格冻结交付",
      "stage": 4,
      "row": 4,
      "tag": "验收通过"
    }
  ],
